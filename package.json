{
  "name": "pal-desktop",
  "productName": "Pal Desktop",
  "version": "1.0.0",
  "description": "An AI chat app for desktop and mobile that remembers every session and chat. Works with on-device models, local servers (Ollama, LM Studio) and cloud APIs (Claude, OpenAI).",
  "main": "main.js",
  "author": "bandar9994",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/**/*.test.js\"",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "build:web": "node scripts/build-web.mjs",
    "icons": "node scripts/make-icons.js",
    "android:sync": "npm run build:web && cap sync android",
    "android:open": "npm run android:sync && cap open android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "dompurify": "^3.2.0",
    "marked": "^18.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/share": "^8.0.2",
    "@wllama/wllama": "^3.6.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.28.2"
  },
  "build": {
    "appId": "com.bandar9994.paldesktop",
    "productName": "Pal Desktop",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "build/icon.png",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "icon": "build/icon.png",
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    }
  }
}
