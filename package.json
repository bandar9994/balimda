{
  "name": "balimda",
  "productName": "Balimda",
  "version": "1.0.0",
  "description": "Najwa AI: a private AI chat app for desktop and mobile that remembers every chat. Runs models on your device (with GPU acceleration on Snapdragon phones), on your own computer (Ollama, LM Studio) or in the cloud (Claude, OpenAI).",
  "main": "main.js",
  "author": {
    "name": "Bandar Altariqi",
    "url": "https://github.com/bandar9994"
  },
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "electron .",
    "test": "node scripts/run-tests.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "build:web": "node scripts/build-web.mjs",
    "icons": "node scripts/make-icons.js",
    "android:sync": "npm run build:web && cap sync android",
    "android:open": "npm run android:sync && cap open android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "dompurify": "^3.4.17",
    "marked": "^18.1.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/share": "^8.0.3",
    "@resvg/resvg-js": "^2.6.2",
    "@wllama/wllama": "^3.8.1",
    "balimda-llama": "file:native/llama",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.28.2"
  },
  "build": {
    "appId": "com.bandaraltariqi.najwa",
    "productName": "Najwa AI",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "build/icon.png",
      "package.json",
      "LICENSE",
      "THIRD-PARTY-NOTICES.md",
      "google-oauth.json"
    ],
    "extraResources": [
      {
        "from": "whisper-bin/${os}-${arch}",
        "to": "whisper"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "icon": "build/icon.png",
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "guid": "2cbbff7f-0a7d-5cf3-a833-f00e752fcab7"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Najwa AI listens when you click the microphone, so you can talk to your AI instead of typing. What you say is turned into text on this Mac."
      },
      "identity": "-",
      "hardenedRuntime": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "maintainer": "Bandar Altariqi <bandar9994@users.noreply.github.com>",
      "synopsis": "Najwa AI by Bandar Altariqi: private AI chat that remembers every chat"
    },
    "copyright": "Copyright © 2026 Bandar Altariqi"
  },
  "homepage": "https://github.com/bandar9994/najwa-ai"
}
